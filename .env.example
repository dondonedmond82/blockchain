# Application
PORT=3000
HOST=127.0.0.1
API_KEY=replace-with-a-long-random-secret
DATA_FILE=./data/ledger.json
LEDGER_MODE=local

# CORS is disabled by default. Add explicit origins only if a browser client needs them.
CORS_ORIGIN=

# Arena integration
# The Arena adapter is deliberately not enabled until the installed Arena API
# endpoint, authentication method and record payload have been verified.
ARENA_BASE_URL=
ARENA_API_TOKEN=
ARENA_WEBHOOK_SECRET=

# Hyperledger Fabric Gateway (required only when LEDGER_MODE=fabric)
FABRIC_CHANNEL=forest-traceability
FABRIC_CHAINCODE=forest-traceability
FABRIC_MSP_ID=MinistryMSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.ministry.example.com
FABRIC_TLS_CERT_PATH=./fabric/peer-tls-ca.crt
FABRIC_CERT_PATH=./fabric/client-cert.pem
FABRIC_KEY_PATH=./fabric/client-key.pem
